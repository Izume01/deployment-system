# ==========================================
# Mini-Render / Railway Platform Environment
# ==========================================

# Database (Neon / Supabase Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Asynchronous Queue & Real-Time Pub/Sub (Upstash Redis)
REDIS_URL="rediss://default:password@host:port"

# Google Cloud Platform (GCP)
GCP_PROJECT_ID="paas-platform-12345"
GCP_REGION="us-central1"
GCP_ARTIFACT_REGISTRY="paas-platform-12345-apps"
GCP_SOURCE_BUCKET="paas-platform-12345-source-bucket"
GCP_BUILD_TIMEOUT="600s"

# Platform Service Ports
API_PORT=4000
PROXY_PORT=8000
DASHBOARD_PORT=3000

# Security & Secrets
JWT_SECRET="super-secret-random-key-change-me"
INTERNAL_API_KEY="internal-shared-secret-between-proxy-and-api"

# Platform Root Domain
PLATFORM_DOMAIN="localhost:8000"
